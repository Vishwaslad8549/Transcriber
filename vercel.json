{
  "version": 2,
  "builds": [
    {
      "src": "dist/transcriber-fe/server/server.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/transcriber-fe/**"]
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "dist/transcriber-fe/server/server.mjs"
    }
  ]
}